<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface">

    <!-- Landing screen -->
    <LinearLayout
        android:id="@+id/landing_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/app_header"
            android:layout_width="match_parent"
            android:layout_height="196dp"
            android:background="@drawable/header_gradient">

            <View
                android:layout_width="190dp"
                android:layout_height="190dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="-70dp"
                android:layout_marginEnd="-50dp"
                android:background="@drawable/circle_glow" />

            <View
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_gravity="bottom|start"
                android:layout_marginStart="-40dp"
                android:layout_marginBottom="-50dp"
                android:background="@drawable/circle_glow" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingTop="24dp"
                android:paddingEnd="24dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:contentDescription="@string/app_name"
                        android:src="@drawable/ic_brand" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/app_name"
                            android:textColor="@android:color/white"
                            android:textSize="24sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/tagline"
                            android:textColor="#E0E7FF"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/open_button"
                    android:layout_width="wrap_content"
                    android:layout_height="46dp"
                    android:layout_marginTop="18dp"
                    android:text="@string/open_document"
                    android:textAllCaps="false"
                    android:textColor="@color/primary"
                    android:textSize="15sp"
                    app:backgroundTint="@android:color/white"
                    app:cornerRadius="23dp"
                    app:icon="@drawable/ic_upload"
                    app:iconTint="@color/primary"
                    app:iconPadding="10dp" />
            </LinearLayout>
        </FrameLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="20dp">

            <LinearLayout
                android:id="@+id/empty_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/card"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="2dp"
                    app:contentPadding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="128dp"
                            android:layout_height="128dp"
                            android:contentDescription="@string/empty_title"
                            android:src="@drawable/ic_empty_state" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/empty_title"
                            android:textColor="@color/on_surface"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center"
                            android:text="@string/empty_body"
                            android:textColor="@color/muted"
                            android:textSize="14sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/browse_button"
                            android:layout_width="wrap_content"
                            android:layout_height="46dp"
                            android:layout_marginTop="20dp"
                            android:text="@string/browse_files"
                            android:textAllCaps="false"
                            app:cornerRadius="23dp"
                            app:icon="@drawable/ic_upload"
                            app:iconPadding="10dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- Full-screen continuous-scroll document -->
    <FrameLayout
        android:id="@+id/document_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0F172A"
        android:visibility="gone">

        <TextView
            android:id="@+id/file_name"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:alpha="0"
            android:text="@string/untitled_document"
            android:visibility="gone" />

        <com.example.doclens.PdfPageView
            android:id="@+id/page_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/untitled_document" />

        <!-- Top action bar: title row plus a centered row of document actions -->
        <LinearLayout
            android:id="@+id/top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:background="@drawable/top_bar_background"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="16dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/back_button"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:contentDescription="@string/close_document"
                    app:backgroundTint="#33FFFFFF"
                    app:cornerRadius="20dp"
                    app:icon="@drawable/ic_arrow_back"
                    app:iconTint="#FFFFFF" />

                <TextView
                    android:id="@+id/doc_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/untitled_document"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/page_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/top_pill_background"
                    android:paddingStart="14dp"
                    android:paddingTop="7dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="7dp"
                    android:text="@string/page_info"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/save_button"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:contentDescription="@string/save"
                    app:backgroundTint="@color/primary"
                    app:cornerRadius="22dp"
                    app:icon="@drawable/ic_save"
                    app:iconTint="#FFFFFF" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/previous_button"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:contentDescription="@string/previous"
                    app:backgroundTint="#33FFFFFF"
                    app:cornerRadius="19dp"
                    app:icon="@drawable/ic_chevron_left"
                    app:iconTint="#FFFFFF" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/next_button"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:contentDescription="@string/next"
                    app:backgroundTint="#33FFFFFF"
                    app:cornerRadius="19dp"
                    app:icon="@drawable/ic_chevron_right"
                    app:iconTint="#FFFFFF" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="22dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:background="#44FFFFFF" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/undo_button"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:contentDescription="@string/undo"
                    app:backgroundTint="#33FFFFFF"
                    app:cornerRadius="19dp"
                    app:icon="@drawable/ic_undo"
                    app:iconTint="#FFFFFF" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/redo_button"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:contentDescription="@string/redo"
                    app:backgroundTint="#33FFFFFF"
                    app:cornerRadius="19dp"
                    app:icon="@drawable/ic_redo"
                    app:iconTint="#FFFFFF" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/clear_button"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:contentDescription="@string/clear_marks"
                    app:backgroundTint="#33FFFFFF"
                    app:cornerRadius="19dp"
                    app:icon="@drawable/ic_clear"
                    app:iconTint="#FFFFFF" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/pages_button"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:contentDescription="@string/pages"
                    app:backgroundTint="#33FFFFFF"
                    app:cornerRadius="19dp"
                    app:icon="@drawable/ic_file"
                    app:iconTint="#FFFFFF" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Centered bottom tool tray: hidden until a single tap on the page -->
    <FrameLayout
        android:id="@+id/tools_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:clickable="true"
        android:elevation="12dp"
        android:focusable="true"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="28dp"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/tools_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/tool_tray_background"
            android:padding="8dp"
            app:selectionRequired="false"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tool_pen"
                android:layout_width="92dp"
                android:layout_height="66dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:text="@string/tool_pen"
                android:textAllCaps="false"
                android:textColor="@color/tool_content_tint"
                android:textSize="11sp"
                app:backgroundTint="@color/tool_tint"
                app:cornerRadius="20dp"
                app:icon="@drawable/ic_pen"
                app:iconGravity="textTop"
                app:iconPadding="2dp"
                app:iconSize="22dp"
                app:iconTint="@color/tool_content_tint" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tool_highlight"
                android:layout_width="92dp"
                android:layout_height="66dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:text="@string/tool_highlight"
                android:textAllCaps="false"
                android:textColor="@color/tool_content_tint"
                android:textSize="11sp"
                app:backgroundTint="@color/tool_tint"
                app:cornerRadius="20dp"
                app:icon="@drawable/ic_highlight"
                app:iconGravity="textTop"
                app:iconPadding="2dp"
                app:iconSize="22dp"
                app:iconTint="@color/tool_content_tint" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tool_sign"
                android:layout_width="92dp"
                android:layout_height="66dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:text="@string/tool_sign"
                android:textAllCaps="false"
                android:textColor="@color/tool_content_tint"
                android:textSize="11sp"
                app:backgroundTint="@color/tool_tint"
                app:cornerRadius="20dp"
                app:icon="@drawable/ic_sign"
                app:iconGravity="textTop"
                app:iconPadding="2dp"
                app:iconSize="22dp"
                app:iconTint="@color/tool_content_tint" />
        </com.google.android.material.button.MaterialButtonToggleGroup>
    </FrameLayout>

</FrameLayout>
